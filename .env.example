# =============================================================================
# OpenCodeReview — Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose automatically loads from .env.  For direct CLI usage,
# export vars manually or use a tool like direnv / dotenv.
#
# Required vars are marked [REQUIRED]; all others are optional.
# =============================================================================


# ─── AI Provider ─────────────────────────────────────────────────────────────
# [REQUIRED] Groq API key for the AI reviewers (correctness, security,
# test-coverage, aggregator).  Get one at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here


# ─── GitHub API ──────────────────────────────────────────────────────────────
# [REQUIRED] GitHub personal access token with "repo" scope.
# Used for:
#   - Fetching PR diffs and changed files
#   - Posting review comments
#   - Fetching evaluation data (eval_data/fetcher.py)
#   - Building vector-store indexes from repo file trees
#
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here


# ─── GitHub OAuth (Device Flow) ──────────────────────────────────────────────
# [Optional] OAuth App client ID for interactive login via:
#   opencodereview auth login
#
# Register a new OAuth App at https://github.com/settings/developers
# and enable Device Flow in the app settings.
# GITHUB_OAUTH_CLIENT_ID=Iv23li_your_client_id_here


# ─── Observability: LangSmith (Tracing) ──────────────────────────────────────
# [Optional] LangSmith enables full run tracing via LangChain/LangGraph.
# Get a key at: https://smith.langchain.com
# LANGCHAIN_API_KEY=lsv2_your_key_here
#
# [Optional] LangSmith project name (default: "opencodereview")
# LANGCHAIN_PROJECT=opencodereview


# ─── Observability: Langfuse (Tracing) ──────────────────────────────────────
# [Optional] Langfuse provides an alternative tracing backend.
# Both public and secret keys are required to enable it.
# Sign up at: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk_your_public_key_here
# LANGFUSE_SECRET_KEY=sk_your_secret_key_here
#
# [Optional] Langfuse host URL (default: https://cloud.langfuse.com)
# For self-hosted: http://localhost:3000
# LANGFUSE_HOST=https://cloud.langfuse.com


# ─── Fallback AI Provider ────────────────────────────────────────────────────
# [Optional] Anthropic API key (used as fallback via config.py/Settings).
# OPENCODEREVIEW_ANTHROPIC_KEY=sk-ant_your_key_here


# ─── Alerting Webhooks ───────────────────────────────────────────────────────
# [Optional] Webhook URLs for the smoke-test alerting monitor
# (scripts/alert.py).  Set at least one to receive notifications when the
# smoke-test score deviates significantly from baseline.
#
# Create a Discord webhook at: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id
#
# Create a Slack webhook at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK=https://hooks.slack.com/services/your_webhook


# ─── Hugging Face Spaces (Deployment) ───────────────────────────────────────
# [Optional] Used by .github/workflows/deploy-hf.yml to sync to HF Spaces.
# Get a token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here


# ─── Server ──────────────────────────────────────────────────────────────────
# [Optional] Port for the Gradio web UI (default: 7860).
# HF Spaces sets this automatically.
# PORT=7860
